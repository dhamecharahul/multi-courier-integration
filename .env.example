NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/multi_courier
LOG_LEVEL=info

BULK_MAX_ORDERS=100
BULK_CONCURRENCY=5

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=300
HTTP_TIMEOUT_MS=10000

URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_USERNAME=
URBANEBOLT_PASSWORD=
URBANEBOLT_CUSTOMER_CODE=

# These paths are intentionally configurable because the supplied assignment
# links to a Postman collection. Verify them against the current UAT collection.
URBANEBOLT_AUTH_PATH=/api/auth/login
URBANEBOLT_CREATE_PATH=/api/order/create
URBANEBOLT_TRACK_PATH=/api/order/track
URBANEBOLT_CANCEL_PATH=/api/order/cancel
