{
  "info": {
    "name": "Multi-Courier Integration Platform",
    "_postman_id": "multi-courier-demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "orderId",
      "value": "ORD-1001"
    },
    {
      "key": "batchId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courier_partner\": \"mockcourier\",\n  \"order_id\": \"ORD-1001\",\n  \"weight\": 1.5,\n  \"payment_mode\": \"COD\",\n  \"collectable_value\": 999,\n  \"declared_value\": 999,\n  \"item_description\": \"Bluetooth speaker\",\n  \"service_type\": \"NDD\",\n  \"dimensions\": {\n    \"length\": 20,\n    \"breadth\": 15,\n    \"height\": 10\n  },\n  \"consignee\": {\n    \"name\": \"John\",\n    \"address\": \"123 Main Road\",\n    \"city\": \"Pune\",\n    \"state\": \"Maharashtra\",\n    \"pincode\": \"411001\",\n    \"mobile\": \"9876543210\"\n  },\n  \"shipper\": {\n    \"name\": \"Acme\",\n    \"address\": \"Industrial Area\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"pincode\": \"400001\",\n    \"mobile\": \"9876543211\"\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/orders"
      }
    },
    {
      "name": "Track",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/track"
      }
    },
    {
      "name": "Cancel",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel"
      }
    },
    {
      "name": "Bulk",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"orders\":[]}"
        },
        "url": "{{baseUrl}}/api/v1/orders/bulk"
      }
    },
    {
      "name": "Batch Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/orders/bulk/{{batchId}}"
      }
    }
  ]
}